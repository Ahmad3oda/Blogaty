# =============================================================================
# Blogaty Environment Configuration & Secrets Template (.env.example)
# Copy this file to '.env' and fill in your actual credentials.
# =============================================================================

# --- MySQL Database Configuration ---
DB_DATABASE=blog_directory
DB_USERNAME=ouda
DB_PASSWORD=your_mysql_password_here
MYSQL_ROOT_PASSWORD=your_root_password_here
DB_PORT=3306

# --- Redis Configuration ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Application Security & JWT ---
# Generate a secure 256-bit key via: openssl rand -base64 64
JWT_SECRET=your_base64_jwt_secret_here

# --- Service Ports ---
BACKEND_PORT=8080
FRONTEND_PORT=5173
HTTP_PORT=80
HTTPS_PORT=443
